{
  "name": "Feather Markdown",
  "short_name": "Feather",
  "description": "A lightweight Markdown reader and editor",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f3f8fc",
  "theme_color": "#f3f8fc",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
